# Copy to .env.production (never commit that file); provide real managed-service values.
NODE_ENV=production
PORT=4000
LOG_LEVEL=info
FRONTEND_URL=https://app.example.com
BACKEND_URL=https://api.example.com

# Managed PostgreSQL connection. Require TLS according to the provider's instructions.
DATABASE_URL=postgresql://USER:PASSWORD@DB_HOST:5432/DATABASE?schema=public&sslmode=require

# Render Key Value internal Redis: leave password blank and TLS false.
# For an authenticated external Redis, provide REDIS_PASSWORD and set REDIS_TLS=true.
REDIS_HOST=REDIS_HOST
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false
QUEUE_NAME=email-queue

# Set false to run without Elasticsearch. Set true only with HTTPS and credentials.
ELASTICSEARCH_ENABLED=false
ELASTICSEARCH_NODE=
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_INDEX=emails

# Google OAuth web client; register the exact HTTPS callback URL.
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=https://api.example.com/auth/google/callback

# Optional Slack OAuth app and callback URL.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=https://api.example.com/api/slack/callback

# Generate unique secrets; COOKIE_SECURE must remain true in production.
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_EXPIRES_IN=7d
COOKIE_SECURE=true
ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS

# Ethereal is a test mailbox service, not a production bulk-delivery provider.
# Sender SMTP credentials are created and persisted by the sender-seeding script.
ETHEREAL_SENDER_COUNT=3
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587

# Queue and worker behavior
WORKER_CONCURRENCY=5
MIN_DELAY_BETWEEN_EMAILS_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200
DEFAULT_HOURLY_LIMIT=100
EMAIL_MAX_ATTEMPTS=3
STALE_PROCESSING_MS=120000
QUEUE_INFRA_MAX_ATTEMPTS=8
QUEUE_INFRA_RETRY_DELAY_MS=1000
QUEUE_MAX_RECOVERY_CYCLES=3
RECOVERY_ON_BOOT=true
BULL_BOARD_PATH=/admin/queues
