# ---------- General ----------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:4000

# ---------- PostgreSQL ----------
DATABASE_URL=postgresql://sendora:sendora@localhost:5433/sendora?schema=public

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false
QUEUE_NAME=email-queue

# ---------- Elasticsearch ----------
ELASTICSEARCH_ENABLED=true
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_INDEX=emails

# ---------- Google OAuth ----------
GOOGLE_CLIENT_ID=mock-google-client-id
GOOGLE_CLIENT_SECRET=mock-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback

# ---------- Session / Security ----------
# Replace this development-only placeholder with a random value before starting the app.
JWT_SECRET=replace-this-development-only-secret-value
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false
# Generate with: openssl rand -hex 32. Used to encrypt Slack webhook URLs.
ENCRYPTION_KEY=replace-with-64-hex-characters

# ---------- Slack OAuth ----------
SLACK_CLIENT_ID=mock-slack-client-id
SLACK_CLIENT_SECRET=mock-slack-client-secret
SLACK_REDIRECT_URI=http://localhost:4000/api/slack/callback

# ---------- Ethereal / SMTP ----------
ETHEREAL_SENDER_COUNT=3
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
# Ethereal is for testing only; sender account credentials are persisted by seed-senders.

# ---------- Scheduler behaviour ----------
WORKER_CONCURRENCY=5
MIN_DELAY_BETWEEN_EMAILS_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200
DEFAULT_HOURLY_LIMIT=100
EMAIL_MAX_ATTEMPTS=3
STALE_PROCESSING_MS=120000
QUEUE_INFRA_MAX_ATTEMPTS=8
QUEUE_INFRA_RETRY_DELAY_MS=1000
QUEUE_MAX_RECOVERY_CYCLES=3
RECOVERY_ON_BOOT=true

# ---------- Bull Board ----------
BULL_BOARD_PATH=/admin/queues
